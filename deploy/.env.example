# Copy this file to deploy/.env before starting the stack.
# Use URL-safe characters for the PostgreSQL password because it is embedded in the database URL.
LSA_POSTGRES_DB=lsa
LSA_POSTGRES_USER=lsa
LSA_POSTGRES_PASSWORD=replace-with-a-long-url-safe-database-password

LSA_S3_ACCESS_KEY=replace-with-a-long-object-store-access-key
LSA_S3_SECRET_KEY=replace-with-a-long-object-store-secret-key
LSA_S3_BUCKET=lsa-evidence
LSA_S3_REGION=us-east-1
# Use AES256 for AWS S3. The bundled MinIO needs KMS configured before
# object-level server-side encryption can be enabled.
LSA_S3_SERVER_SIDE_ENCRYPTION=none
LSA_ARTIFACT_RETENTION_DAYS=365

LSA_SESSION_SECRET=replace-with-at-least-32-random-characters
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LSA_SETTINGS_ENCRYPTION_KEY=DEOXPmN1UnYYmJOHcse7e1p96ltyDlfPsNq0fh-39m4=
LSA_BOOTSTRAP_EMAIL=admin@example.com
LSA_BOOTSTRAP_PASSWORD=replace-with-a-long-administrator-password

# LSA exposes HTTPS only. The first start creates a 30-day localhost certificate;
# replace it from Settings > TLS certificates before production use.
LSA_TLS_HOST=localhost
LSA_TLS_BIND=127.0.0.1
LSA_TLS_PORT=8443
# Managed agents use a separate outbound-only data-plane listener. Set the
# public URL to the DNS name agents resolve and trust.
LSA_AGENT_TLS_BIND=127.0.0.1
LSA_AGENT_TLS_PORT=8444
LSA_AGENT_PUBLIC_URL=https://localhost:8444
# This supported profile intentionally keeps agent certificate verification
# disabled. Production use must keep 8444 on managed internal networks only.
LSA_AGENT_NETWORK_SCOPE=internal
LSA_AGENT_FIREWALL_ACKNOWLEDGED=false
# Enable only for an on-premises ADFS/OIDC endpoint on a trusted private network.
LSA_ALLOW_PRIVATE_IDENTITY_PROVIDERS=false
LSA_MANAGEMENT_TLS_INSTALLED=false

LSA_SEED_DEMO=false
LSA_REQUIRE_SIGNED_BUNDLES=true
# Set true only after confirming the Docker volume resides on encrypted storage
# or after configuring MinIO KMS-backed server-side encryption.
LSA_VOLUME_ENCRYPTION_ACKNOWLEDGED=false
LSA_BACKUP_RESTORE_DRILL_ACKNOWLEDGED=false
LSA_WEB_CONCURRENCY=2
LSA_MAX_UPLOAD_BYTES=26214400

# Vulnerability intelligence is refreshed by a dedicated outbound-only worker.
# The API remains attached only to the internal backend network.
LSA_VULNERABILITY_SYNC_ENABLED=true
LSA_VULNERABILITY_REFRESH_HOURS=12
LSA_VULNERABILITY_POLL_SECONDS=15
LSA_VULNERABILITY_HTTP_TIMEOUT_SECONDS=30
LSA_VULNERABILITY_HTTP_RETRIES=3
# For an outbound TLS-inspection proxy, place the approved PEM bundle in
# deploy/ca and set this to its container path, for example:
# LSA_VULNERABILITY_CA_BUNDLE=/etc/lsa/ca/company-ca.pem
LSA_VULNERABILITY_FAILURE_RETRY_MINUTES=15
LSA_VULNERABILITY_RUN_TIMEOUT_MINUTES=60
