[Unit]
Description=Linux Security Auditor agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/lsa-agent/venv/bin/python /opt/lsa-agent/agent/lsa_agent.py --config /etc/lsa-agent/config.json daemon
Restart=on-failure
RestartSec=30
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/
ReadWritePaths=/var/lib/lsa-agent

[Install]
WantedBy=multi-user.target
