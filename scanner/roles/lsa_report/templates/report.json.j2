{
  "schema_version": {{ lsa_schema_version | to_json }},
  "report_id": {{ lsa_report_id | to_json }},
  "generated_at": {{ lsa_generated_at | to_json }},
  "scanner": {"name": "Linux Security Auditor", "version": {{ lsa_scanner_version | to_json }}},
  "host": {
    "host_id": {{ lsa_host_id | to_json }},
    "hostname": {{ ansible_facts.hostname | to_json }},
    "fqdn": {{ ansible_facts.fqdn | default(none) | to_json }},
    "machine_id_hash": {{ lsa_machine_id_hash | to_json }},
    "operating_system": {{ ansible_facts.distribution | to_json }},
    "os_family": {{ lsa_os_family | to_json }},
    "os_version": {{ ansible_facts.distribution_version | to_json }},
    "kernel": {{ ansible_facts.kernel | to_json }},
    "architecture": {{ ansible_facts.architecture | to_json }},
    "ip_addresses": {{ ansible_facts.all_ipv4_addresses | default([]) | to_json }},
    "tags": {{ lsa_host_tags | default({}) | to_json }},
    "system_info": {
      "cpu_model": {{ ansible_facts.processor | default([]) | last | default('unknown') | to_json }},
      "cpu_cores": {{ ansible_facts.processor_vcpus | default(ansible_facts.processor_count | default(0)) | int }},
      "memory_mb": {{ ansible_facts.memtotal_mb | default(0) | int }},
      "uptime_seconds": {{ ansible_facts.uptime_seconds | default(0) | int }},
      "virtualization_type": {{ ansible_facts.virtualization_type | default('physical') | to_json }},
      "virtualization_role": {{ ansible_facts.virtualization_role | default('host') | to_json }},
      "system_vendor": {{ ansible_facts.system_vendor | default('unknown') | to_json }},
      "product_name": {{ ansible_facts.product_name | default('unknown') | to_json }},
      "timezone": {{ ansible_facts.date_time.tz | default('unknown') | to_json }}
    }
  },
  "applications": {{ lsa_applications | to_json }},
  "scan": {"profile": {{ lsa_effective_profile | to_json }}, "modules": {{ lsa_effective_modules | to_json }}},
  "summary": {{ lsa_summary | to_json }},
  "findings": {{ lsa_findings | to_json }}
}
