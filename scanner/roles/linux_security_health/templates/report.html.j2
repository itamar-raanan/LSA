<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Security Health - {{ security_health_report_hostname }}</title>
<style>
:root{--bg:#0c1220;--panel:#151d31;--panel2:#1b2540;--text:#eef3ff;--muted:#9eabc7;--line:#2c3858;--accent:#7c9cff;--pass:#35d49a;--fail:#ff657a;--review:#ffca62;--info:#62c8ff;--error:#c985ff}
*{box-sizing:border-box} body{margin:0;background:linear-gradient(135deg,#0b1020,#101a2f 55%,#0b1020);color:var(--text);font:14px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.page{max-width:1550px;margin:auto;padding:28px}.hero{padding:26px;border:1px solid var(--line);background:linear-gradient(135deg,rgba(124,156,255,.16),rgba(53,212,154,.06));border-radius:20px;box-shadow:0 18px 60px rgba(0,0,0,.28)}h1{margin:0 0 8px;font-size:30px}.sub{color:var(--muted)}.meta{display:flex;gap:18px;flex-wrap:wrap;margin-top:16px}.meta span{background:rgba(255,255,255,.05);border:1px solid var(--line);padding:7px 11px;border-radius:9px}.cards{display:grid;grid-template-columns:repeat(6,minmax(120px,1fr));gap:12px;margin:18px 0}.card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px}.card b{display:block;font-size:25px}.card small{color:var(--muted)}.toolbar{position:sticky;top:0;z-index:20;display:flex;gap:10px;flex-wrap:wrap;padding:13px;margin:0 0 12px;background:rgba(12,18,32,.94);backdrop-filter:blur(12px);border:1px solid var(--line);border-radius:14px}.toolbar input,.toolbar select,.toolbar button{background:var(--panel2);color:var(--text);border:1px solid var(--line);border-radius:9px;padding:9px 12px}.toolbar input{min-width:280px;flex:1}.toolbar button{cursor:pointer}.grid{display:grid;gap:12px}.finding{background:var(--panel);border:1px solid var(--line);border-left:5px solid var(--accent);border-radius:14px;overflow:hidden}.finding.FAIL{border-left-color:var(--fail)}.finding.PASS{border-left-color:var(--pass)}.finding.REVIEW{border-left-color:var(--review)}.finding.ERROR{border-left-color:var(--error)}.finding.NOT_APPLICABLE,.finding.EXCLUDED{opacity:.72}.head{display:grid;grid-template-columns:110px 125px 130px 1fr auto;gap:12px;align-items:center;padding:16px 18px;cursor:pointer}.id{font-weight:800;color:#b8c8ff}.badge{display:inline-flex;justify-content:center;border:1px solid currentColor;border-radius:999px;padding:4px 8px;font-weight:800;font-size:11px}.sev.CRITICAL{color:#ff516d}.sev.HIGH{color:#ff8a65}.sev.MEDIUM{color:#ffca62}.sev.LOW{color:#7cdeaa}.sev.INFO{color:#62c8ff}.status.PASS{color:var(--pass)}.status.FAIL{color:var(--fail)}.status.REVIEW{color:var(--review)}.status.ERROR{color:var(--error)}.title{font-weight:750;font-size:15px}.category{color:var(--muted)}.body{display:none;border-top:1px solid var(--line);padding:18px;background:rgba(255,255,255,.018)}.finding.open .body{display:block}.cols{display:grid;grid-template-columns:1fr 1fr;gap:14px}.box{background:#0f1729;border:1px solid var(--line);border-radius:11px;padding:14px}.box h3{margin:0 0 8px;font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:#aebee4}.box pre{white-space:pre-wrap;overflow:auto;margin:0;color:#dbe5ff}.action{border-color:#536da9;background:#111c34}.copy{float:right;background:#23345d;color:#fff;border:1px solid #536da9;border-radius:7px;padding:5px 8px;cursor:pointer}.empty{text-align:center;padding:50px;color:var(--muted)}@media(max-width:950px){.cards{grid-template-columns:repeat(3,1fr)}.head{grid-template-columns:90px 110px 1fr}.head .category,.head .status{display:none}.cols{grid-template-columns:1fr}}@media print{body{background:#fff;color:#111}.toolbar{display:none}.finding,.card,.hero,.box{background:#fff;color:#111;box-shadow:none}.body{display:block!important}.page{max-width:none}}
</style>
</head>
<body>
{% set pass_count = security_health_results | selectattr('status','equalto','PASS') | list | length %}
{% set fail_count = security_health_results | selectattr('status','equalto','FAIL') | list | length %}
{% set review_count = security_health_results | selectattr('status','equalto','REVIEW') | list | length %}
{% set error_count = security_health_results | selectattr('status','equalto','ERROR') | list | length %}
{% set critical_count = security_health_results | selectattr('severity','equalto','CRITICAL') | rejectattr('status','equalto','PASS') | list | length %}
{% set high_count = security_health_results | selectattr('severity','equalto','HIGH') | rejectattr('status','equalto','PASS') | list | length %}
<div class="page">
<section class="hero"><h1>Linux Security Health</h1><div class="sub">Operational risk findings beyond configuration compliance</div><div class="meta"><span>Host: <b>{{ security_health_report_hostname }}</b></span><span>OS: {{ ansible_distribution | default('') }} {{ ansible_distribution_version | default('') }}</span><span>Kernel: {{ ansible_kernel | default('') }}</span><span>UTC: {{ security_health_report_timestamp }}</span></div></section>
<div class="cards"><div class="card"><b>{{ security_health_results|length }}</b><small>Checks</small></div><div class="card"><b style="color:var(--pass)">{{ pass_count }}</b><small>Pass</small></div><div class="card"><b style="color:var(--fail)">{{ fail_count }}</b><small>Fail</small></div><div class="card"><b style="color:var(--review)">{{ review_count }}</b><small>Review</small></div><div class="card"><b style="color:#ff516d">{{ critical_count }}</b><small>Open critical</small></div><div class="card"><b style="color:#ff8a65">{{ high_count }}</b><small>Open high</small></div></div>
<div class="toolbar"><input id="q" placeholder="Search title, category, evidence or remediation"><select id="status"><option value="">All statuses</option><option>FAIL</option><option>REVIEW</option><option>ERROR</option><option>PASS</option><option>NOT_APPLICABLE</option><option>EXCLUDED</option></select><select id="severity"><option value="">All severities</option><option>CRITICAL</option><option>HIGH</option><option>MEDIUM</option><option>LOW</option><option>INFO</option></select><button onclick="actionItems()">Action items</button><button onclick="resetFilters()">Reset</button></div>
<div class="grid" id="grid">
{% for r in security_health_results %}<article class="finding {{ r.status }}" data-status="{{ r.status }}" data-severity="{{ r.severity }}" data-search="{{ (r.id ~ ' ' ~ r.title ~ ' ' ~ r.category ~ ' ' ~ r.actual ~ ' ' ~ r.remediation) | lower | e }}"><div class="head" onclick="this.parentElement.classList.toggle('open')"><div class="id">{{ r.id }}</div><div><span class="badge sev {{ r.severity }}">{{ r.severity }}</span></div><div class="category">{{ r.category }}</div><div class="title">{{ r.title }}</div><div><span class="badge status {{ r.status }}">{{ r.status }}</span></div></div><div class="body"><div class="cols"><div class="box"><h3>Why this matters</h3>{{ r.risk }}</div><div class="box"><h3>Check summary</h3>{{ r.summary }}</div><div class="box"><h3>Observed evidence</h3><pre>{{ r.actual | default('No output') }}</pre></div><div class="box action"><button class="copy" onclick="event.stopPropagation();copyText(this)">Copy</button><h3>What to do</h3><pre class="copy-source">{{ r.remediation }}</pre></div><div class="box"><h3>Verify after change</h3><pre>{{ r.verification }}</pre></div><div class="box"><h3>Technical details</h3><pre>Return code: {{ r.evidence.rc }}{% if r.evidence.stderr %}\n{{ r.evidence.stderr | join('\n') }}{% endif %}</pre></div></div></div></article>{% endfor %}
</div><div class="empty" id="empty" hidden>No findings match the current filters.</div>
</div>
<script>
const q=document.getElementById('q'),status=document.getElementById('status'),severity=document.getElementById('severity');function apply(){let shown=0;document.querySelectorAll('.finding').forEach(x=>{const okQ=!q.value||x.dataset.search.includes(q.value.toLowerCase()),okS=!status.value||x.dataset.status===status.value,okV=!severity.value||x.dataset.severity===severity.value;const show=okQ&&okS&&okV;x.style.display=show?'':'none';if(show)shown++});document.getElementById('empty').hidden=shown!==0}q.oninput=apply;status.onchange=apply;severity.onchange=apply;function actionItems(){status.value='';q.value='';document.querySelectorAll('.finding').forEach(x=>{x.style.display=['FAIL','REVIEW','ERROR'].includes(x.dataset.status)?'':'none'});document.getElementById('empty').hidden=true}function resetFilters(){q.value='';status.value='';severity.value='';apply()}async function copyText(btn){const t=btn.parentElement.querySelector('.copy-source').innerText;await navigator.clipboard.writeText(t);const old=btn.innerText;btn.innerText='Copied';setTimeout(()=>btn.innerText=old,1200)}
</script>
</body></html>
