        {"family": "almalinux", "versions": ["8", "9"]}
      ],
      "risk": "medium",
      "parameters": [
        {"name": "desired_value", "type": "integer", "required": true, "default": 0, "allowed_values": [0], "minimum": 0, "maximum": 0, "description": "The reviewed setuid core-dump policy value."}
      ],
      "preconditions": [
        {"kind": "command_available", "resource": "sysctl", "expected": "available", "failure_mode": "stop", "description": "The sysctl interface must be available."}
      ],
      "operations": [
        {"kind": "sysctl_setting", "resource": "kernel", "path": "/etc/sysctl.d/60-lsa-process.conf", "format": "sysctl", "key": "fs.suid_dumpable", "value_from": "desired_value", "backup_required": true},
