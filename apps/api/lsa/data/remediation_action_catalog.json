    {
      "action_id": "linux.network.ipv4-forwarding.disabled",
      "version": 1,
      "status": "reviewed",
      "control_ids": ["CIS-DEBIAN13-3.3.1.1", "LSA-HEALTH-NET-003"],
      "title": "Disable IPv4 Packet Forwarding",
      "description": "Persist and load net.ipv4.ip_forward=0 on hosts that are not approved routers.",
      "supported_systems": [
        {"family": "debian", "versions": ["12", "13"]},
        {"family": "ubuntu", "versions": ["22.04", "24.04"]},
        {"family": "redhat", "versions": ["8", "9"]},
        {"family": "rocky", "versions": ["8", "9"]},
        {"family": "almalinux", "versions": ["8", "9"]},
        {"family": "oraclelinux", "versions": ["8", "9"]}
      ],
      "risk": "high",
      "parameters": [
        {"name": "desired_value", "type": "integer", "required": true, "default": 0, "allowed_values": [0], "minimum": 0, "maximum": 0, "description": "The reviewed forwarding value for non-router hosts."}
      ],
      "preconditions": [
        {"kind": "host_role_not", "resource": "network_role", "expected": "router", "failure_mode": "stop", "description": "The host must not be assigned an approved router role."},
        {"kind": "manual_confirmation", "resource": "network_owner_approval", "expected": "confirmed", "failure_mode": "stop", "description": "The service owner must confirm the host does not route traffic between network zones."}
      ],
      "operations": [
        {"kind": "sysctl_setting", "resource": "kernel", "path": "/etc/sysctl.d/60-lsa-network.conf", "format": "sysctl", "key": "net.ipv4.ip_forward", "value_from": "desired_value", "backup_required": true},
        {"kind": "sysctl_reload", "resource": "kernel", "backup_required": false}
      ],
      "validation": [
        {"kind": "sysctl_value", "resource": "kernel", "key": "net.ipv4.ip_forward", "expected": 0}
      ],
      "rollback": [
        {"kind": "restore_backup", "resource": "kernel", "path": "/etc/sysctl.d/60-lsa-network.conf", "backup_required": false},
        {"kind": "sysctl_reload", "resource": "kernel", "backup_required": false}
      ],
      "impact": {"service_restart": false, "reboot_required": false, "availability": "role_dependent", "notes": "Disabling forwarding immediately interrupts traffic when the host is acting as a router or gateway."}
    },
