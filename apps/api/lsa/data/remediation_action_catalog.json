{
  "catalog_schema_version": "1.0",
  "actions": [
    {
      "action_id": "linux.ssh.permit-root-login.disabled",
      "version": 1,
      "status": "reviewed",
      "control_ids": ["CIS-DEBIAN13-5.1.21", "LSA-HEALTH-SSH-002"],
      "title": "Disable Direct Root SSH Login",
      "description": "Set the effective OpenSSH PermitRootLogin value to no after alternate administrative access is confirmed.",
      "supported_systems": [
        {"family": "debian", "versions": ["12", "13"]},
        {"family": "ubuntu", "versions": ["22.04", "24.04"]},
        {"family": "redhat", "versions": ["8", "9"]},
        {"family": "rocky", "versions": ["8", "9"]},
        {"family": "almalinux", "versions": ["8", "9"]},
        {"family": "oraclelinux", "versions": ["8", "9"]},
        {"family": "centos", "versions": ["8", "9"]}
      ],
      "risk": "high",
      "parameters": [
        {"name": "desired_value", "type": "enum", "required": true, "default": "no", "allowed_values": ["no"], "description": "The only reviewed target value for PermitRootLogin."}
      ],
      "preconditions": [
        {"kind": "package_present", "resource": "openssh_server", "expected": "present", "failure_mode": "stop", "description": "The OpenSSH server package must be installed."},
        {"kind": "command_available", "resource": "sshd", "expected": "available", "failure_mode": "stop", "description": "The sshd configuration validator must be available."},
        {"kind": "manual_confirmation", "resource": "alternate_administrative_access", "expected": "confirmed", "failure_mode": "stop", "description": "A tested sudo-capable account or approved recovery path must exist before this change."}
      ],
      "operations": [
        {"kind": "config_setting", "resource": "openssh_server", "path": "/etc/ssh/sshd_config.d/90-lsa-hardening.conf", "format": "sshd_config", "key": "PermitRootLogin", "value_from": "desired_value", "backup_required": true},
        {"kind": "service_reload", "resource": "openssh_server", "backup_required": false}
      ],
      "validation": [
        {"kind": "effective_setting", "resource": "openssh_server", "key": "permitrootlogin", "expected": "no"}
      ],
      "rollback": [
        {"kind": "restore_backup", "resource": "openssh_server", "path": "/etc/ssh/sshd_config.d/90-lsa-hardening.conf", "backup_required": false},
        {"kind": "service_reload", "resource": "openssh_server", "backup_required": false}
      ],
      "impact": {"service_restart": true, "reboot_required": false, "availability": "brief_connection_risk", "notes": "Reloading OpenSSH should preserve established sessions, but invalid access assumptions can prevent new privileged logins."}
    },
    {
