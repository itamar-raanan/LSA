{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lsa.dev/schemas/report-v1.schema.json",
  "title": "Linux Security Auditor report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "generated_at", "scanner", "host", "scan", "summary", "findings"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "report_id": { "type": "string", "format": "uuid" },
    "generated_at": { "type": "string", "format": "date-time" },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "version": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_id", "hostname", "machine_id_hash", "operating_system", "os_family", "os_version", "kernel", "architecture"],
      "properties": {
        "host_id": { "type": "string", "format": "uuid" },
        "hostname": { "type": "string", "minLength": 1, "maxLength": 253 },
        "fqdn": { "type": ["string", "null"], "maxLength": 253 },
        "machine_id_hash": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
        "operating_system": { "type": "string", "minLength": 1, "maxLength": 100 },
        "os_family": { "enum": ["debian", "ubuntu", "rhel"] },
        "os_version": { "type": "string", "minLength": 1, "maxLength": 40 },
        "kernel": { "type": "string", "minLength": 1, "maxLength": 100 },
        "architecture": { "type": "string", "minLength": 1, "maxLength": 40 },
        "ip_addresses": { "type": "array", "items": { "type": "string" }, "maxItems": 64 },
        "tags": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 120 } },
        "system_info": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu_model": { "type": "string", "maxLength": 300 },
            "cpu_cores": { "type": "integer", "minimum": 0 },
            "memory_mb": { "type": "integer", "minimum": 0 },
            "uptime_seconds": { "type": "integer", "minimum": 0 },
            "virtualization_type": { "type": "string", "maxLength": 80 },
            "virtualization_role": { "type": "string", "maxLength": 80 },
            "system_vendor": { "type": "string", "maxLength": 200 },
            "product_name": { "type": "string", "maxLength": 200 },
            "timezone": { "type": "string", "maxLength": 80 }
          }
        }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "modules"],
      "properties": {
        "profile": { "type": "string", "minLength": 1, "maxLength": 100 },
        "modules": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 80 }, "minItems": 1, "uniqueItems": true }
      }
    },
    "applications": {
      "type": "array",
      "items": { "$ref": "#/$defs/application" },
      "maxItems": 20000
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "fail", "manual", "not_applicable", "error"],
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "manual": { "type": "integer", "minimum": 0 },
        "not_applicable": { "type": "integer", "minimum": 0 },
        "error": { "type": "integer", "minimum": 0 },
        "compliance_score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "security_score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" },
      "maxItems": 50000
    }
  },
  "$defs": {
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "source", "status", "enabled", "running"],
      "properties": {
        "kind": { "enum": ["package", "service"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "version": { "type": ["string", "null"], "maxLength": 300 },
        "architecture": { "type": ["string", "null"], "maxLength": 80 },
        "source": { "enum": ["dpkg", "rpm", "systemd"] },
        "source_package": { "type": ["string", "null"], "maxLength": 300 },
        "source_version": { "type": ["string", "null"], "maxLength": 300 },
        "purl": { "type": ["string", "null"], "maxLength": 1000 },
        "publisher": { "type": ["string", "null"], "maxLength": 300 },
        "description": { "type": ["string", "null"], "maxLength": 1000 },
        "status": { "type": "string", "minLength": 1, "maxLength": 80 },
        "enabled": { "type": ["boolean", "null"] },
        "running": { "type": ["boolean", "null"] }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_id", "module", "category", "title", "severity", "status"],
      "properties": {
        "control_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "module": { "type": "string", "minLength": 1, "maxLength": 80 },
        "category": { "type": "string", "minLength": 1, "maxLength": 80 },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "status": { "enum": ["pass", "fail", "manual", "not_applicable", "error"] },
        "expected": { "type": ["string", "null"], "maxLength": 10000 },
        "actual": { "type": ["string", "null"], "maxLength": 10000 },
        "evidence": { "type": "array", "items": { "type": "string", "maxLength": 10000 }, "maxItems": 100 },
        "remediation_summary": { "type": ["string", "null"], "maxLength": 10000 },
        "remediation_commands": { "type": "array", "items": { "type": "string", "maxLength": 10000 }, "maxItems": 100 },
        "verification_commands": { "type": "array", "items": { "type": "string", "maxLength": 10000 }, "maxItems": 100 },
        "reboot_required": { "type": "boolean", "default": false },
        "service_restart": { "type": "boolean", "default": false }
      }
    }
  }
}
